+package util
+
+import "testing"
+
+func TestConfiguredCredentialedOrigins(t *testing.T) {
+	allowlist := "https://www.openlims.ai, https://pm.openlims.ai"
+	for _, origin := range []string{"https://www.openlims.ai", "https://pm.openlims.ai"} {
+		if !IsConfiguredCredentialedOrigin(origin, allowlist) {
+			t.Errorf("approved origin refused: %q", origin)
+		}
+	}
+	for _, origin := range []string{
+		"", "null", "*", "http://www.openlims.ai", "https://evil.openlims.ai",
+		"https://www.openlims.ai.evil.example", "https://www.openlims.ai:8443",
+		"https://www.openlims.ai/", "https://www.openlims.ai/path",
+		"https://www.openlims.ai?", "https://www.openlims.ai?x=1",
+		"https://www.openlims.ai#fragment", "https://user@www.openlims.ai",
+		"https://www.openlims.ai https://pm.openlims.ai", "https://[invalid",
+	} {
+		if IsConfiguredCredentialedOrigin(origin, allowlist) {
+			t.Errorf("unapproved/malformed origin trusted: %q", origin)
+		}
+	}
+	for _, configured := range []string{"", "*", "https://*.openlims.ai", "https://www.openlims.ai/"} {
+		if IsConfiguredCredentialedOrigin("https://www.openlims.ai", configured) {
+			t.Errorf("nonexact/empty configuration trusted: %q", configured)
+		}
+	}
+	if IsConfiguredCredentialedOrigin("http://www.openlims.ai", "http://www.openlims.ai") ||
+		IsConfiguredCredentialedOrigin("https://user@www.openlims.ai", "https://user@www.openlims.ai") {
+		t.Fatal("unsafe origin allowed even when configured verbatim")
+	}
+}
