+package util
+
+import (
+	"net/url"
+	"strings"
+)
+
+// IsConfiguredCredentialedOrigin trusts only an exact HTTPS origin explicitly
+// listed by the operator. Empty configuration preserves upstream defaults.
+// Never infer cookie trust from OAuth redirect URIs, suffixes, or wildcards.
+func IsConfiguredCredentialedOrigin(origin, configured string) bool {
+	if origin == "" || strings.Contains(origin, "*") {
+		return false
+	}
+	u, err := url.Parse(origin)
+	if err != nil || u.Scheme != "https" || u.Hostname() == "" || u.User != nil ||
+		u.Opaque != "" || u.Path != "" || u.RawPath != "" || u.RawQuery != "" ||
+		u.ForceQuery || u.Fragment != "" || u.RawFragment != "" {
+		return false
+	}
+	for _, allowed := range strings.Split(configured, ",") {
+		if origin == strings.TrimSpace(allowed) {
+			return true
+		}
+	}
+	return false
+}
