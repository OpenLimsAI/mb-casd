+// Local regression maintained by OpenLimsAI/mb-casd, not an upstream fork.
+package controllers
+
+import (
+    "errors"
+    "reflect"
+    "testing"
+)
+
+func TestPasswordRevocationAttemptsAllStoresAndClearsCaller(t *testing.T) {
+    for _, failure := range []string{"none", "tokens", "sessions", "both"} {
+        t.Run(failure, func(t *testing.T) {
+            calls := []string{}
+            tokenErr, sessionErr := errors.New("tokens"), errors.New("sessions")
+            err := runPasswordRevocation(passwordRevocationOps{
+                notify: func() { calls = append(calls, "notify") },
+                expireTokens: func() error {
+                    calls = append(calls, "tokens")
+                    if failure == "tokens" || failure == "both" { return tokenErr }; return nil
+                },
+                deleteSessions: func() error {
+                    calls = append(calls, "sessions")
+                    if failure == "sessions" || failure == "both" { return sessionErr }; return nil
+                },
+                clearCurrent: func() { calls = append(calls, "clear") },
+            })
+            if !reflect.DeepEqual(calls, []string{"notify", "tokens", "sessions", "clear"}) { t.Fatalf("not all revocations attempted: %v", calls) }
+            if errors.Is(err, tokenErr) != (failure == "tokens" || failure == "both") { t.Fatal("token failure lost") }
+            if errors.Is(err, sessionErr) != (failure == "sessions" || failure == "both") { t.Fatal("session failure lost") }
+        })
+    }
+}
+
+func TestExplicitCredentialColumnsAreRecognized(t *testing.T) {
+    for _, col := range []string{"password", "password_salt", "password_type"} {
+        if !passwordColumnChanged([]string{col}, col, "old", "new") { t.Fatalf("missed %s", col) }
+        if passwordColumnChanged([]string{"display_name"}, col, "old", "new") { t.Fatalf("unwritten %s", col) }
+        if passwordColumnChanged([]string{col}, col, "same", "same") { t.Fatalf("unchanged %s", col) }
+    }
+    if passwordColumnChanged([]string{"password"}, "password", "old", "***") { t.Fatal("masked password is not a mutation") }
+}
