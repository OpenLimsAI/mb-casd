+
+// A separate, default-off exception, never a new general DCR API allowlist entry.
+// AutoSigninFilter has already validated the exact bearer token and active user.
+// No browser cookie can select or be destroyed as an unrelated subject.
+func allowOwnDcrGlobalLogout(ctx *context.Context, app *object.Application) bool {
+	if app == nil {
+		return false
+	}
+	query, err := url.ParseQuery(ctx.Request.URL.RawQuery)
+	if err != nil {
+		return false
+	}
+	user := getSessionUser(ctx)
+	credential, _ := ctx.Input.GetData(requestCredentialUserKey).(string)
+	r := dcrSelfLogoutRequest{
+		Method: ctx.Request.Method, Path: ctx.Request.URL.Path,
+		Authorization: ctx.Request.Header.Get("Authorization"), User: user, CredentialUser: credential,
