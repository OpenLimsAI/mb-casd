+// Password changes invalidate both issued tokens and unredeemed authorization
+// codes. ExpiresIn alone is not checked when redeeming a still-valid code.
+func ExpirePasswordGrantsByUser(owner, username string) (bool, error) {
+    affected, err := ormer.Engine.Where(fmt.Sprintf("organization = ? and %s = ?", quoteColumn("user")), owner, username).
+        Cols("expires_in", "code_is_used", "code_expire_in").
+        Update(&Token{ExpiresIn: 0, CodeIsUsed: true, CodeExpireIn: 0})
+    return affected != 0, err
+}
+
+func DeletePasswordUserSessions(owner, username string) (bool, error) {
+    sessions, err := GetUserSessions(owner, username)
+    if err != nil { return false, err }
+    ids := []string{}
+    for _, session := range sessions { ids = append(ids, session.SessionId...) }
+    return runPasswordSessionDestruction(ids, func(id string) error {
+        if err := web.GlobalSessions.GetProvider().SessionDestroy(context.Background(), id); err != nil {
+            // Session IDs and provider responses must not leak into API errors.
+            return fmt.Errorf("password session destruction incomplete")
+        }
+        return nil
+    }, func() (bool, error) {
+        return DeleteAllUserSessions(owner, username)
+    })
+}
