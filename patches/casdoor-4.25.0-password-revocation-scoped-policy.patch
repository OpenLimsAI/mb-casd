+func (c *ApiController) ownSelfPolicy(user *object.User, aud string) (*object.SelfPolicy,error) {
+ query,err:=url.ParseQuery(c.Ctx.Request.URL.RawQuery)
+ if err!=nil{return nil,nil}
+ application,err:=object.GetApplicationByClientId(aud)
+ if err!=nil{return nil,err}
+ if application==nil{return nil,nil}
+ credential,_:=c.Ctx.Input.GetData("requestCredentialUser").(string)
+ allowed:=allowSelfPolicy(selfPolicyRequest{Method:c.Ctx.Request.Method,Authorization:c.Ctx.Request.Header.Get("Authorization"),
+  User:user.GetId(),CredentialUser:credential,Organization:application.Organization,ClientID:application.ClientId,
+  Configured:conf.GetConfigString("openlimsSelfPolicyApplications"),BodyLength:c.Ctx.Request.ContentLength,Query:query})
+ if !allowed{return nil,nil}
+ return object.GetSelfPolicy(user)
+}
+
+// The PM resource client authenticates using its existing OAuth Basic secret;
+// the subject is solely the already-validated active user access token, never an ID parameter.
+func (c *ApiController) introspectedSelfPolicy(reader, tokenApp *object.Application, token *object.Token, tokenValue, subject string) (*object.SelfPolicy,error) {
+ if reader==nil || tokenApp==nil || token==nil || tokenValue=="" || tokenValue!=token.AccessToken || token.GrantType=="client_credentials" || token.User=="" ||
+  c.Ctx.Request.Method!="POST" || c.Ctx.Request.URL.RawQuery!="" {return nil,nil}
+ client,_,basic:=c.getClientBasicAuth()
+ if !basic || client!=reader.ClientId || token.Organization!=tokenApp.Organization ||
+  !allowIntrospectedSelfPolicy(conf.GetConfigString("openlimsSelfPolicyApplications"),conf.GetConfigString("openlimsSelfPolicyDelegationBindings"),reader.Organization,reader.ClientId,token.Organization,tokenApp.ClientId) {return nil,nil}
+ if err:=c.Ctx.Request.ParseForm();err!=nil{return nil,nil}
+ form:=c.Ctx.Request.PostForm
+ if len(form)!=2 || len(form["token"])!=1 || form.Get("token")!=tokenValue || len(form["token_type_hint"])!=1 || form.Get("token_type_hint")!="access_token" {return nil,nil}
+ user,err:=object.GetUser(token.Organization+"/"+token.User)
+ if err!=nil{return nil,err}
+ if user==nil || user.Id!=subject {return nil,nil}
+ return object.GetSelfPolicy(user)
+}
