+// Local security backport maintained in OpenLimsAI/mb-casd.
+package object
+
+import "errors"
+
+// Keep rows for a retry if any real session destruction fails. A failed token
+// update must never prevent an independent attempt to destroy browser sessions.
+func runPasswordSessionDestruction(ids []string, destroy func(string) error, dropRows func() (bool, error)) (bool, error) {
+    seen := map[string]bool{}
+    failures := []error{}
+    for _, id := range ids {
+        if id == "" || seen[id] { continue }
+        seen[id] = true
+        if err := destroy(id); err != nil { failures = append(failures, err) }
+    }
+    if len(failures) > 0 { return false, errors.Join(failures...) }
+    return dropRows()
+}
