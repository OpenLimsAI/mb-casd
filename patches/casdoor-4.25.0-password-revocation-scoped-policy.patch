+package object
+
+import (
+    "errors"
+    "reflect"
+    "testing"
+)
+
+func TestPasswordSessionDestructionIndependentAndRetryable(t *testing.T) {
+    for _, failed := range []bool{false, true} {
+        calls := []string{}
+        fault := errors.New("session store unavailable")
+        changed, err := runPasswordSessionDestruction([]string{"a", "a", "b", ""}, func(id string) error {
+            calls = append(calls, id)
+            if failed && id == "a" { return fault }; return nil
+        }, func() (bool, error) { calls = append(calls, "rows"); return true, nil })
+        expected := []string{"a", "b", "rows"}
+        if failed { expected = []string{"a", "b"} }
+        if !reflect.DeepEqual(calls, expected) { t.Fatalf("calls=%v; want=%v", calls, expected) }
+        if errors.Is(err, fault) != failed || changed == failed { t.Fatalf("incorrect result changed=%v error=%v", changed, err) }
+    }
+}
