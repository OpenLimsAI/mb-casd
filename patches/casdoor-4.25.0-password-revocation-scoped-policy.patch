+package controllers
+
+import "github.com/casdoor/casdoor/object"
+
+const mfaCredentialVersionSession = "mfaCredentialVersion"
+
+func (c *ApiController) getSessionCredentialVersion() string {
+ value,_:=c.GetSession("credentialVersion").(string);return value
+}
+
+func (c *ApiController) getMfaCredentialVersion() string {
+ value,_:=c.GetSession(mfaCredentialVersionSession).(string);return value
+}
+
+// Resumed proofs retain the credential version seen when authentication began.
+// Loading the latest user while finishing MFA must not rebind an older proof.
+func (c *ApiController) credentialVersionForSignin(user *object.User) string {
+ if c.Ctx.Input.Param("mfaSignin")=="true" { return c.getMfaCredentialVersion() }
+ if c.Ctx.Input.Param("sessionSignin")=="true" { return c.getSessionCredentialVersion() }
+ return object.UserCredentialVersion(user)
+}
+
+func (c *ApiController) checkedCredentialVersion(user *object.User) (string,bool) {
+ version:=c.credentialVersionForSignin(user)
+ current,err:=object.CredentialVersionCurrent(user.Owner,user.Name,version)
+ if err!=nil || !current {
+  c.ClearUserSession()
+  c.ResponseError("Credentials changed or cannot be verified; sign in again")
+  return "",false
+ }
+ return version,true
+}
