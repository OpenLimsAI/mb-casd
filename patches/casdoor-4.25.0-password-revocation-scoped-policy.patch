+package object
+
+// The digest is private server metadata, not a password verifier or a JWT claim.
+// No new secret is required. Credential changes invalidate the snapshot without
+// relying on clock precision or on token/session cleanup succeeding.
+func UserCredentialVersion(user *User) string {
+ if user==nil { return "" }
+ return credentialDigest(user.Id,user.Password,user.PasswordSalt,user.PasswordType,user.LastChangePasswordTime)
+}
+func CredentialVersionCurrent(owner, name, bound string) (bool,error) {
+ user,err:=getUser(owner,name)
+ if err!=nil { return false,err }
+ return user!=nil && !user.IsForbidden && !user.IsDeleted && credentialVersionsMatch(bound,UserCredentialVersion(user)),nil
+}
