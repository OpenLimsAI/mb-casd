+        credentialDigest("other", "first-hash", "salt", "bcrypt", "same-millisecond"),
+        credentialDigest("synthetic", "first-hash", "new-salt", "bcrypt", "same-millisecond"),
+        credentialDigest("synthetic", "first-hash", "salt", "new-kind", "same-millisecond"),
+    } { if original == item { t.Fatal("identity/salt/type not bound") } }
+}
