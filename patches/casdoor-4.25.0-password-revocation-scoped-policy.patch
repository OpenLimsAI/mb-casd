+// Local credential epoch, never an authentication secret or public claim.
+package object
+import (
+ "crypto/sha256"
+ "crypto/subtle"
+ "encoding/hex"
+ "encoding/json"
+)
+func credentialDigest(id, password, salt, kind, changed string) string {
+ encoded, _ := json.Marshal([]string{"mb-casd-credential-v1",id,password,salt,kind,changed})
+ digest := sha256.Sum256(encoded)
+ return hex.EncodeToString(digest[:])
+}
+func credentialVersionsMatch(bound, current string) bool {
+ if len(bound)!=64 || len(current)!=64 { return false }
+ return subtle.ConstantTimeCompare([]byte(bound),[]byte(current))==1
+}
