+package routers
+
+import (
+	"net/http"
+
+	"github.com/beego/beego/v2/server/web"
+	"github.com/beego/beego/v2/server/web/context"
+)
+
+// Beego SessionStart adds its newly generated cookie to Request before filters.
+// Match the official isSessionCreatedInRequest logic: this in-request cookie is
+// not a browser credential. Any other caller cookie remains ambiguous and denied.
+func hasBrowserLogoutCookie(ctx *context.Context) bool {
+	generated := (&http.Response{Header:ctx.ResponseWriter.Header()}).Cookies()
+	for _, incoming := range ctx.Request.Cookies() {
+		fresh := false
+		if incoming.Name == web.BConfig.WebConfig.Session.SessionName {
+			for _, item := range generated {
+				if item.Name == incoming.Name && item.Value == incoming.Value { fresh=true;break }
+			}
+		}
+		if !fresh { return true }
+	}
+	return false
+}
