+// Local security backport maintained in OpenLimsAI/mb-casd.
+package controllers
+
+import "errors"
+
+func passwordColumnChanged(columns []string, field, before, after string) bool {
+    if before == after || (field == "password" && after == "***") { return false }
+    for _, column := range columns { if column == field { return true } }
+    return false
+}
+
+type passwordRevocationOps struct {
+    notify func()
+    expireTokens func() error
+    deleteSessions func() error
+    clearCurrent func()
+}
+
+// Notifications enumerate active tokens before authoritative revocation. Their
+// delivery is not the authority. Attempt both stores and clear this caller even
+// when one store fails. This is synchronous compensation, not an atomic transaction.
+func runPasswordRevocation(ops passwordRevocationOps) error {
+    ops.notify()
+    tokenErr := ops.expireTokens()
+    sessionErr := ops.deleteSessions()
+    ops.clearCurrent()
+    return errors.Join(tokenErr, sessionErr)
+}
