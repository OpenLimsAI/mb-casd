+// RotateRefreshToken persists the replacement and consumes the original grant
+// in one transaction. Concurrent consumers must not retain orphan replacements.
+// A failed insert/delete/commit leaves no returned token; the caller can retry
+// the original grant when the database has actually rolled the transaction back.
+func rotateRefreshToken(original, replacement *Token) (bool, error) {
+	if original == nil || replacement == nil || original.RefreshTokenHash == "" ||
+		original.Organization != replacement.Organization || original.Application != replacement.Application {
+		return false, nil
+	}
+	session := ormer.Engine.NewSession()
+	defer session.Close()
+	if err := session.Begin(); err != nil {
+		return false, err
+	}
+	defer session.Rollback()
+	replacement.popularHashes()
+	inserted, err := session.Insert(replacement)
+	if err != nil {
+		return false, err
+	}
+	if inserted != 1 {
+		return false, fmt.Errorf("refresh replacement was not persisted")
+	}
+	consumed, err := session.ID(core.PK{original.Owner, original.Name}).
+		Where("organization = ? AND refresh_token_hash = ? AND expires_in > 0", original.Organization, original.RefreshTokenHash).
+		Delete(&Token{})
+	if err != nil {
+		return false, err
+	}
+	if consumed != 1 {
+		return false, nil
+	}
+	if err := session.Commit(); err != nil {
+		return false, err
+	}
+	return true, nil
 }
 
