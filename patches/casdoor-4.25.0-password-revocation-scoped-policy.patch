+package controllers
+
+import ("net/url"; "strings")
+
+// Evaluated after normal provider token, credential-version and active-user checks.
+type selfPolicyRequest struct {
+ Method, Authorization, User, CredentialUser, Organization, ClientID, Configured string
+ BodyLength int64
+ Query url.Values
+}
+
+func allowSelfPolicy(r selfPolicyRequest) bool {
+ if r.Method!="GET" || r.BodyLength!=0 || len(r.Query)!=0 {return false}
+ auth:=strings.Fields(r.Authorization)
+ if len(auth)!=2 || auth[0]!="Bearer" || auth[1]=="" || r.CredentialUser=="" || r.CredentialUser!=r.User {return false}
+ user:=strings.Split(r.User,"/")
+ if len(user)!=2 || user[0]=="app" || user[0]=="built-in" || user[1]=="" || user[0]!=r.Organization {return false}
+ for _,allowed:=range strings.Split(r.Configured,",") {if strings.TrimSpace(allowed)==r.Organization+"/"+r.ClientID && r.ClientID!="" {return true}}
+ return false
+}
+
+func allowIntrospectedSelfPolicy(configured, bindings, readerOrg, readerClient, tokenOrg, tokenClient string) bool {
+ if readerOrg=="" || readerOrg=="built-in" || readerOrg!=tokenOrg || readerClient=="" || tokenClient=="" {return false}
+ reader,token:=readerOrg+"/"+readerClient,tokenOrg+"/"+tokenClient
+ allowed:=false
+ for _,item:=range strings.Split(configured,",") {if strings.TrimSpace(item)==reader {allowed=true}}
+ if !allowed{return false}
+ if reader==token{return true}
+ for _,item:=range strings.Split(bindings,",") {if strings.TrimSpace(item)==reader+"="+token {return true}}
+ return false
+}
