+package routers
+
+import (
+	"net/url"
+	"strings"
+)
+
+// Evaluated only after the existing bearer/token/user validation filters.
+type dcrSelfLogoutRequest struct {
+	Method, Path, Authorization, User, CredentialUser string
+	ApplicationOrganization, ClientID, Configured, DeviceConfigured string
+	Dynamic, CrossOrganization, HasCookie bool
+	BodyLength int64
+	Query url.Values
+}
+
+func allowDcrSelfLogout(r dcrSelfLogoutRequest) bool {
+	if r.Method != "POST" || r.Path != "/api/sso-logout" || !r.Dynamic || r.CrossOrganization || r.HasCookie || r.BodyLength != 0 {
+		return false
+	}
+	auth := strings.Fields(r.Authorization)
+	if len(auth) != 2 || auth[0] != "Bearer" || auth[1] == "" || r.CredentialUser == "" || r.CredentialUser != r.User {
+		return false
+	}
+	user := strings.Split(r.User, "/")
+	if len(user) != 2 || user[0] == "app" || user[1] == "" || user[0] != r.ApplicationOrganization || r.ApplicationOrganization == "built-in" {
+		return false
+	}
+	if len(r.Query) != 1 || len(r.Query["logoutAll"]) != 1 {
+		return false
+	}
+	configured := r.Configured
+	if r.Query["logoutAll"][0] == "false" { configured = r.DeviceConfigured
+	} else if r.Query["logoutAll"][0] != "true" { return false }
+	for _, allowed := range strings.Split(configured, ",") {
+		if strings.TrimSpace(allowed) == r.ApplicationOrganization+"/"+r.ClientID {
+			return true
+		}
+	}
+	return false
+}
