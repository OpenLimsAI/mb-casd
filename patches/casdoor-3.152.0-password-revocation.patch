+package controllers
+
+import (
+	"errors"
+	"reflect"
+	"testing"
+)
+
+func TestPasswordRevocationAttemptsAllStoresAndSurfacesFailures(t *testing.T) {
+	for _, failure := range []string{"", "tokens", "sessions", "both"} {
+		t.Run(failure, func(t *testing.T) {
+			calls := []string{}
+			err := runPasswordRevocation(passwordRevocationOps{
+				notify: func() { calls = append(calls, "notify") },
+				expireTokens: func() error {
+					calls = append(calls, "tokens")
+					if failure == "tokens" || failure == "both" {
+						return errors.New("synthetic token store failure")
+					}
+					return nil
+				},
+				deleteSessions: func() error {
+					calls = append(calls, "sessions")
+					if failure == "sessions" || failure == "both" {
+						return errors.New("synthetic session store failure")
+					}
+					return nil
+				},
+				clearCurrent: func() { calls = append(calls, "clear-current") },
+			})
+			if !reflect.DeepEqual(calls, []string{"notify", "tokens", "sessions", "clear-current"}) {
+				t.Fatalf("unexpected order: %v", calls)
+			}
+			if (err != nil) != (failure != "") {
+				t.Fatalf("unexpected error: %v", err)
+			}
+		})
+	}
+}
