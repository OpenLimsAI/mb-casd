+package object
+
+import (
+	_ "github.com/go-sql-driver/mysql"
+	_ "github.com/lib/pq"
+	"github.com/xorm-io/xorm"
+	"testing"
+)
+
+func TestTokenUserPredicateQuotesReservedColumnForEachDialect(t *testing.T) {
+	cases := []struct{ driver, dsn, want string }{
+		{"postgres", "host=invalid.invalid user=synthetic dbname=synthetic sslmode=disable", `organization = ? and "user" = ?`},
+		{"mysql", "synthetic:synthetic@tcp(invalid.invalid:3306)/synthetic", "organization = ? and `user` = ?"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.driver, func(t *testing.T) {
+			// NewEngine selects a dialect without opening a network connection.
+			engine, err := xorm.NewEngine(tc.driver, tc.dsn)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer engine.Close()
+			if got := tokenUserPredicate(engine.Quote); got != tc.want {
+				t.Fatalf("predicate = %q, want %q", got, tc.want)
+			}
+		})
+	}
+}
