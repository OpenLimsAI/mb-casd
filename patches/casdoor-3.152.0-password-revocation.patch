+// revokePasswordSessions uses the existing provider-wide logout primitives.
+// Notifications run before expiry because they enumerate active tokens. The
+// authoritative token and SSO revocation does not rely on notification delivery.
+func (c *ApiController) revokePasswordSessions(user *object.User) error {
+	currentUser := c.GetSessionUsername()
+	return runPasswordRevocation(passwordRevocationOps{
+		notify: func() { object.SendBackchannelLogout(user.Owner, user.Name, "", c.Ctx.Request.Host) },
+		expireTokens: func() error {
+			_, err := object.ExpireTokenByUser(user.Owner, user.Name)
+			return err
+		},
+		deleteSessions: func() error {
+			_, err := object.DeleteAllUserSessions(user.Owner, user.Name)
+			return err
+		},
+		clearCurrent: func() {
+			if currentUser == user.GetId() {
+				c.ClearUserSession()
+				c.ClearTokenSession()
+			}
+		},
+	})
