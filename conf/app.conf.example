appname = casdoor
httpport = 8000
runmode = prod
copyrequestbody = true
driverName = postgres
dataSourceName = "user=POSTGRES_USER password=POSTGRES_PASSWORD host=db port=5432 sslmode=disable dbname=casdoor"
dbName = casdoor
tableNamePrefix =
showSql = false
redisEndpoint =
defaultStorageProvider =
isCloudIntranet = false
authState = "casdoor"
verificationCodeTimeout = 10
initScore = 0
logPostOnly = true
isUsernameLowered = false
origin = "http://localhost:8000"
originFrontend =
# Exact HTTPS origins allowed to read credentialed CORS responses and use the
# IAM session cookie. Empty preserves upstream behavior. No wildcard/suffix match.
# Production portal + PM example: "https://www.openlims.ai,https://pm.openlims.ai"
credentialedOrigins = ""
staticBaseUrl = "https://cdn.casbin.org"
isDemoMode = false
batchSize = 100
showGithubCorner = false
forceLanguage = "zh"
defaultLanguage = "zh"
defaultApplication = "app-built-in"
maxItemsForFlatMenu = 7
enableErrorMask = false
enableGzip = true
ldapServerPort = 389
radiusServerPort = 1812
radiusDefaultOrganization = "built-in"
radiusSecret = "secret"
quota = {"organization": -1, "user": -1, "application": -1, "provider": -1}
logConfig = {"adapter":"file", "filename": "logs/casdoor.log", "maxdays":99999, "perm":"0770"}
initDataNewOnly = true
initDataFile = "/init_data.json"

# Optional mb-casd v11 candidate capability. Empty means disabled.
# Exact organization/clientId entries only; requires separate deployment approval.
dcrSelfLogoutApplications = ""
# Optional v11 candidate; all empty/false by default. Exact org/client IDs.
# Separate approval and matching RP implementation are required before deployment.
dcrSelfLogoutDeviceApplications = ""
openlimsSelfPolicyApplications = ""
# Exact resource-client=delegation-client pairs; no wildcard or extra grant.
openlimsSelfPolicyDelegationBindings = ""
openlimsScopedLogout = false
