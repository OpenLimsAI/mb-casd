# syntax=docker/dockerfile:1.7
# Keep the deployed UI/assets and change only the Go server from its exact source.
FROM --platform=$BUILDPLATFORM golang:1.25.8@sha256:3ac2864710f25e84381bf5d4272261c7ba73ada0339d62034df4de20dabb33ca AS builder
ARG TARGETOS=linux
ARG TARGETARCH
WORKDIR /src
ADD --checksum=sha256:8ce76d5508bbb1b5ac0cb0bf366089732a75269ea69c53a1de3862957696a18d https://api.github.com/repos/casdoor/casdoor/tarball/7325999791deaeab538f86082d70858d0ab4d773 /tmp/upstream.tar.gz
RUN tar -xzf /tmp/upstream.tar.gz --strip-components=1 -C /src && rm /tmp/upstream.tar.gz
COPY patches/casdoor-3.152.0-password-revocation.patch /tmp/revocation.patch
RUN git apply --check /tmp/revocation.patch && git apply /tmp/revocation.patch
RUN go test ./controllers/password_revocation_flow.go ./controllers/password_revocation_flow_test.go \
    && go test ./object/token_user_predicate.go ./object/token_user_predicate_test.go
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags="-s -w" -o /out/server .

FROM casbin/casdoor@sha256:95c7be68fb98daf2ec74a10c9f785af1ef75e8fef6dd4aad455a899e651e87e2
COPY --from=builder --chown=1000:1000 /out/server /server
LABEL org.opencontainers.image.source="https://github.com/OpenLimsAI/mb-casd" \
      ai.openlims.casdoor.source="7325999791deaeab538f86082d70858d0ab4d773" \
      ai.openlims.casdoor.patch="password-revocation-v1"
